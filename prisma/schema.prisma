// Media Tracker — data model (see docs/ARCHITECTURE.md).
// Prisma 7: datasource URL lives in prisma.config.ts (reads DATABASE_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  entries             Entry[]
  recommendationCache RecommendationCache?
}

enum MediaType {
  book
  tv
  movie
}

enum EntryStatus {
  want
  in_progress
  completed
  dropped
}

// v1.1 filtering & richer stats — books-only fields (see docs/ARCHITECTURE.md).
enum AuthorGender {
  female
  male
  non_binary
  mixed
  unknown
}

enum GenreCategory {
  fiction
  non_fiction
  other
}

model Entry {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  mediaType   MediaType
  externalId  String? // TMDB / Open Library id when matched
  creator     String? // author / director
  year        Int? // publication year
  genres      String[]    @default([])
  status      EntryStatus @default(want)
  rating      Int? // 1–5, only meaningful when completed
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  completedAt DateTime? // set when status transitions to completed

  // v1.1: books-only structured metadata. Not nullable for authorGender —
  // "unknown" IS the no-value member, avoiding null-handling in filters/charts.
  authorGender       AuthorGender   @default(unknown)
  genreCategory      GenreCategory? // null = not yet categorized (movies/TV, un-backfilled books)
  subgenres          String[]      @default([]) // validated app-side against taxonomy.ts
  metadataUnverified Boolean       @default(false) // true = AI-backfilled, not yet user-confirmed

  @@index([userId])
  @@index([userId, mediaType])
  @@index([userId, status])
  @@index([userId, genreCategory])
  @@index([userId, authorGender])
  @@index([userId, completedAt])
}

model RecommendationCache {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedAt DateTime @default(now())
  suggestions Json // array of { title, mediaType, reason }
}

// Reference data: "The Greatest Books of All Time" (thegreatestbooks.org, top 500).
// Global, not user-scoped. Used for reading-goal progress + list-based recs.
model GreatBook {
  rank            Int     @id // 1..500 (Position)
  title           String
  author          String
  normalizedTitle String // lowercased, punctuation/articles stripped — for matching
  year            Int?
  score           Int?

  @@index([normalizedTitle])
}
