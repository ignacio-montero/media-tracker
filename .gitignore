# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# keep the example env committed
!.env.example

# personal data — source files used once locally to seed the DB, never committed
*.rtf

# Third-party ranking dataset — scraped from thegreatestbooks.org, not ours to
# redistribute. Kept locally; see docs/GREAT_BOOKS_DATA.md.
the_greatest_books_of_all_time.csv
