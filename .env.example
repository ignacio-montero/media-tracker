# https://www.themoviedb.org/settings/api  (v3 API key)
TMDB_API_KEY=""

# https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Password used by scripts/ingest-books.ts when creating demo accounts.
SEED_PASSWORD=""
