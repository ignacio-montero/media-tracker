# Copy to .env and fill in. .env is git-ignored.
DATABASE_URL="postgresql://media:CHANGEME@localhost:5432/media_tracker?schema=public"

# Must match POSTGRES_PASSWORD used by docker-compose (dev-only local database).
POSTGRES_PASSWORD=""

# Generate with: openssl rand -base64 32
